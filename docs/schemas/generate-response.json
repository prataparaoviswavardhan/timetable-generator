{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GenerateResponse",
  "description": "Output response payload from the timetable generation service",
  "type": "object",
  "required": [
    "status",
    "executionTimeMs",
    "timetable",
    "errors",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["OPTIMAL", "FEASIBLE", "INFEASIBLE", "UNKNOWN", "PRE_CHECK_FAILED"]
    },
    "executionTimeMs": { "type": "number", "minimum": 0 },
    "objectiveValue": { "type": "number" },
    "timetable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sectionId",
          "day",
          "period",
          "subjectId",
          "facultyId",
          "roomId"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sectionId": { "type": "string", "minLength": 1 },
          "day": { "type": "integer", "minimum": 1, "maximum": 7 },
          "period": { "type": "integer", "minimum": 1 },
          "subjectId": { "type": "string", "minLength": 1 },
          "facultyId": { "type": "string", "minLength": 1 },
          "roomId": { "type": "string", "minLength": 1 },
          "batchId": { "type": "string" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "entityType"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "entityType": {
            "type": "string",
            "enum": ["section", "faculty", "subject", "room", "assignment", "config"]
          },
          "entityId": { "type": "string" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
